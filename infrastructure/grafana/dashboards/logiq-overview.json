{
  "title": "LogIQ Service & Worker Health",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "15s",
  "panels": [
    {"type":"stat","title":"API targets up","gridPos":{"x":0,"y":0,"w":6,"h":4},"targets":[{"expr":"sum(up{job=\"logiq-apis\"})"}]},
    {"type":"stat","title":"Worker targets up","gridPos":{"x":6,"y":0,"w":6,"h":4},"targets":[{"expr":"sum(up{job=\"logiq-workers\"})"}]},
    {"type":"timeseries","title":"HTTP requests / second","gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"expr":"sum by (service) (rate(logiq_http_requests_total[5m]))","legendFormat":"{{service}}"}]},
    {"type":"timeseries","title":"HTTP p95 latency","gridPos":{"x":0,"y":4,"w":12,"h":8},"targets":[{"expr":"histogram_quantile(0.95, sum by (le,service) (rate(logiq_http_request_duration_seconds_bucket[5m])))","legendFormat":"{{service}}"}]},
    {"type":"timeseries","title":"Worker processed messages / second","gridPos":{"x":12,"y":8,"w":12,"h":8},"targets":[{"expr":"sum by (service,topic) (rate(logiq_worker_messages_processed_total[5m]))","legendFormat":"{{service}} / {{topic}}"}]},
    {"type":"timeseries","title":"Worker retries and failures / second","gridPos":{"x":0,"y":12,"w":12,"h":8},"targets":[{"expr":"sum by (service) (rate(logiq_worker_message_retries_total[5m]))","legendFormat":"retries {{service}}"},{"expr":"sum by (service) (rate(logiq_worker_messages_failed_total[5m]))","legendFormat":"failed {{service}}"}]},
    {"type":"timeseries","title":"Service scrape availability (1 = up)","gridPos":{"x":12,"y":16,"w":12,"h":8},"targets":[{"expr":"up{job=~\"logiq-apis|logiq-workers\"}","legendFormat":"{{job}} / {{instance}}"}]}
  ]
}
