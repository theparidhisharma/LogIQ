# Generate a unique random value (at least 32 bytes) before deployment.
LOGIQ_JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-bytes
LOGIQ_JWT_TTL_SECONDS=3600
LOGIQ_API_KEY_PEPPER=replace-with-a-separate-random-secret

# MinIO raw dataset artifact storage
MINIO_ACCESS_KEY=logiq
MINIO_SECRET_KEY=replace-with-a-unique-random-secret
MINIO_BUCKET=logiq-raw-datasets

# Local PostgreSQL bootstrap credentials (development only)
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Dataset service-owned database (Compose default)
DATASET_DATABASE_URL=postgresql+psycopg://logiq_dataset:logiq-dataset-dev-only@postgres:5432/logiq_dataset
DATASET_DB_PASSWORD=logiq-dataset-dev-only

# Shared secret for OTel Collector -> Collection internal ingestion. Replace before use.
LOGIQ_OTLP_INGEST_TOKEN=replace-with-a-separate-random-secret

# Dataset upload limit in bytes (default 5 GiB); uploads spool to disk and stream to MinIO.
DATASET_MAX_UPLOAD_BYTES=5368709120
